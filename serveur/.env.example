# Copier ce fichier en .env et adapter les valeurs

# Base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://fittracker:change-me@localhost:5432/fittracker

# JWT
JWT_SECRET_KEY=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISS=fittracker-api
JWT_AUD=fittracker-clients

# Mot de passe des comptes de demonstration crees par le seed
SEED_USER_PASSWORD=change-me
